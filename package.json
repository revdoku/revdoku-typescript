{
  "name": "revdoku",
  "version": "2.2.0",
  "description": "Revdoku API client for Node.js: mailboxes for AI agents, with attachments and private file storage.",
  "author": "Revdoku",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revdoku/revdoku-typescript.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "revdoku",
    "email",
    "inbox",
    "mailbox",
    "inbound-email",
    "attachments",
    "ai-agents",
    "file-storage",
    "api",
    "sdk"
  ],
  "homepage": "https://revdoku.com/docs/sdks/typescript/",
  "bugs": {
    "url": "https://github.com/revdoku/revdoku-typescript/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "REFERENCE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
