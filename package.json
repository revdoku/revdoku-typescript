{
  "name": "@revdoku/api",
  "version": "2.0.0",
  "description": "OpenAPI client for @revdoku/api",
  "author": "Revdoku",
  "repository": {
    "type": "git",
    "url": "https://github.com/revdoku/revdoku-typescript.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^4.0 || ^5.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "examples",
    "README.md",
    "QUICKSTART.md",
    "CONTRIBUTING.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
